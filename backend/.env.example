NODE_ENV=production
PORT=3000
# Option 1: connection string MySQL complète
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/database

# Option 2: variables séparées MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=espace_pastel
DB_USER=espace_pastel
DB_PASSWORD=CHANGE_ME

# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_48_CHARACTERS_MINIMUM
JWT_EXPIRES_IN=8h
# Public front-end URLs, separated by commas
CORS_ORIGIN=https://votre-domaine.tld,https://www.votre-domaine.tld
